build/
*.o
*.a
*.obj
VTK/

# validation/: commit the input cases the ctests actually read (mesh, dicts, and the OF reference
# solutions the tests compare against). Keep the large unused OF-comparison cases out (saf_*, *_of,
# sweep_*, etc., ~1.3 GB that no test reads).
validation/*
!validation/cyclicChannel/
!validation/cyclicChannelAMI/
!validation/cyclicWedge/
!validation/kEpsCase/
!validation/kEpsCorrect/
!validation/komegaCoeffs/
!validation/lmFlatPlate/
!validation/lm_ctest.sh
!validation/matrixDump/
!validation/matrixDumpAsym/
!validation/matrixDumpGAMG/
!validation/matrixDumpSimple/
!validation/mrfBox/
!validation/of_apps/
!validation/pitzDaily/
!validation/pitzDaily282/
!validation/pitzDailyTurb/
!validation/pitzDailyTurbBig/

# CTest-generated output (regenerated on every ctest run)
Testing/

# python bytecode
__pycache__/
*.pyc

# demo: case DATA is regenerated (meshes, time dirs, renders) and stays untracked. The delta demo is
# dictionaries + README only -- no STL (licence) and no mesh, so it is small enough to track.
demo/*
!demo/delta/
demo/delta/[0-9]*/
!demo/delta/0.orig/
demo/delta/constant/polyMesh/
demo/delta/constant/extendedFeatureEdgeMesh/
demo/delta/constant/triSurface/*
!demo/delta/constant/triSurface/README
demo/delta/0/
