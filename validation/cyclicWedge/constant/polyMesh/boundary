FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

5
(
    side1
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          8;
        startFace       82;
        matchTolerance  0.0001;
        transform       rotational;
        neighbourPatch  side2;
        rotationAxis    (0 0 1);
        rotationCentre  (0 0 0);
    }
    side2
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          8;
        startFace       90;
        matchTolerance  0.0001;
        transform       rotational;
        neighbourPatch  side1;
        rotationAxis    (0 0 1);
        rotationCentre  (0 0 0);
    }
    inner
    {
        type            wall;
        inGroups        1(wall);
        nFaces          6;
        startFace       98;
    }
    outer
    {
        type            wall;
        inGroups        1(wall);
        nFaces          6;
        startFace       104;
    }
    frontAndBack
    {
        type            empty;
        inGroups        1(empty);
        nFaces          96;
        startFace       110;
    }
)

